*.mdb.meta

# Builds & CLI diagnostics
*.apk
*.aab
*.unitypackage
*.app
/*.exe
/*.binlog
/*.log
/TestResults*.xml
/test-results*.xml
/test-results*.json
/proxy-request.json

# Crash reports
sysinfo.txt
crashlytics-build.properties

# OS
.DS_Store
Thumbs.db

# Rider/VS solution
*.slnx

# Heavy third-party assets (keep local, not on GitHub)
/[Aa]ssets/_ThirdParty/
/[Aa]ssets/_ThirdParty.meta

# Local code intelligence (rebuild from source; do not commit caches)
/.codegraph/
/graphify-out/
/codegraph.json
/.graphifyignore

# Isolated local Fortress agent repositories; never stage their snapshots in the parent repo
/.fortress-workspaces/

# Unity scene recovery autosaves (never stage or delete user recovery backups)
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

