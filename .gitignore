# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / generated project files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crash reports
sysinfo.txt
crashlytics-build.properties

# OS
.DS_Store
Thumbs.db

# Rider/VS solution
*.slnx

# Heavy third-party assets (keep local, not on GitHub)
/[Aa]ssets/_ThirdParty/
/[Aa]ssets/_ThirdParty.meta

# Local code intelligence (rebuild from source; do not commit caches)
/.codegraph/
/graphify-out/

# Isolated local Fortress agent repositories; never stage their snapshots in the parent repo
/.fortress-workspaces/

# Unity scene recovery autosaves (never stage or delete user recovery backups)
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Local agent persona & scratch files (never commit to course repo)
/AGENTS.habayakka.md
/GEMINI.txt
/*MASTER PROMPT*.md
/tools/caveman-posttooluse.patch
/tools/fortress/
/.agents/
/.codex/
/codegraph.json
/.graphifyignore
/docs/superpowers/
/docs/Fortress/
/docs/Prompt-Lap-Plan-Nha-Giam-Gieng-Chuong.md
/docs/Plan-Trien-Khai-Nha-Giam-Gieng-Chuong.md
/docs/UnityConnection.md
