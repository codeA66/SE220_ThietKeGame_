# Unity generated (anchored at repo root so Assets/**/Build/ etc. are never swallowed)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Cc]rash[Rr]eports/
/[Cc]ode[Cc]overage/
/[Tt]est[Rr]esults/
/.utmp/
/.gradle/
/[Ee]xported[Oo]bj/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Auto-generated JetBrains Rider plugin in Assets
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*.meta

# IDE / generated project files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
