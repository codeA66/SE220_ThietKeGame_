*.app

# Crash reports
sysinfo.txt
crashlytics-build.properties

# OS
.DS_Store
Thumbs.db

# Rider/VS solution
*.slnx

# Heavy third-party assets (keep local, not on GitHub)
/[Aa]ssets/_ThirdParty/
/[Aa]ssets/_ThirdParty.meta
