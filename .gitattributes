# Default text normalization (LF in index and checkouts across Windows/macOS/Linux CI)
* text=auto eol=lf

# Source code, shaders, definitions, docs, and POSIX hooks
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.rsp text eol=lf
*.py text eol=lf
*.sh text eol=lf
.githooks/* text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts & Visual Studio metadata
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.csproj text eol=crlf
.vsconfig text eol=crlf

# Unity YAML serialized text assets -> UnityYAMLMerge (SmartMerge)
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.anim text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.overrideController text merge=unityyamlmerge eol=lf
*.physicMaterial text merge=unityyamlmerge eol=lf
*.physicsMaterial2D text merge=unityyamlmerge eol=lf
*.scenetemplate text merge=unityyamlmerge eol=lf
*.mask text merge=unityyamlmerge eol=lf
*.playable text merge=unityyamlmerge eol=lf
*.guiskin text merge=unityyamlmerge eol=lf
*.fontsettings text merge=unityyamlmerge eol=lf
*.preset text merge=unityyamlmerge eol=lf
*.meta text eol=lf

# Binary media, textures, audio, video, fonts, 3D models & archives -> Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
